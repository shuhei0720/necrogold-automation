+    private func handleCaptureOnlyRPC(method: String, params: [String: JSONValue],
+        origin: NG8RequestOrigin, processService: NG8CaptureService,
+        completion: @escaping ([String: JSONValue]?, JSONRPCError?) -> Void) {
+        let decision = NG8CaptureRoutePolicy.decide(mode: serviceMode, origin: origin,
+            operation: .rpc(method: method, callerParams: JSONRPCServer.capturePolicyValues(params)))
+        guard case .allow(let route) = decision else {
+            completion(nil, captureOnlyError("not_available")); return
+        }
+        switch route {
+        case .probe:
+            guard case .authenticatedRemote(let owner) = origin else {
+                completion(nil, captureOnlyError("authentication_required")); return
+            }
+            // Caller dictionaries do not carry any privileged owner, actor or
+            // peer context. The closed core parser rejects their extra fields.
+            processService.handle(method: method, params: params.mapValues { $0.toAny() },
+                ownerTokenID: owner) { [weak self] response in
+                switch response {
+                case .failure(let failure):
+                    completion(nil, self?.captureOnlyError(failure.rawValue) ?? .internalError)
+                case .success(let object):
+                    guard JSONSerialization.isValidJSONObject(object),
+                          let bytes = try? JSONSerialization.data(withJSONObject: object),
+                          let result = try? JSONDecoder().decode([String: JSONValue].self, from: bytes) else {
+                        completion(nil, .internalError); return
+                    }
+                    completion(result, nil)
+                }
+            }
+        case .remoteConfigRead:
+            completion(captureOnlyRemoteConfig(), nil)
+        case .logs:
+            let all = Self.logBuffer.dumpRedacted().split(separator: "\n").map(String.init)
+            let count = params["max_elements"]?.intValue ?? 80
+            let selected = params["text"]?.stringValue.flatMap { text in
+                text.isEmpty ? nil : all.filter { $0.localizedCaseInsensitiveContains(text) }
+            } ?? all
+            let lines = Array(selected.suffix(count))
+            completion(["lines": .array(lines.map(JSONValue.string)),
+                        "count": .int(lines.count), "total": .int(all.count)], nil)
