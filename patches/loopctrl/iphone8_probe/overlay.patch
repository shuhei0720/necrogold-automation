+        let processService = captureProbe
+        srv.onCaptureOnlyRPC = { [weak self, processService] method, params, origin, reply in
+            guard let self else { reply(nil, .internalError); return }
+            self.handleCaptureOnlyRPC(method: method, params: params ?? [:],
+                origin: origin, processService: processService, completion: reply)
+        }
+        srv.onLog = { Self.logBuffer.append($0) }
+        srv.onLogsRequest = { Self.logBuffer.dumpRedacted() }
