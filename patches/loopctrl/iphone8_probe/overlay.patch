+        let listener = JSONRPCServer(port: Self.persistedPort, localOnly: !remoteAccessEnabled, mode: serviceMode)
+        configureCaptureOnlyCallbacks(listener)
+        server = listener
+        // JSONRPCServer emits false only for failed/cancelled, never setup or
+        // waiting. A queued old callback must not park a newer listener.
+        listener.onStateChange = { [weak self, weak listener] running in
+            guard !running else { return }
+            DispatchQueue.main.async {
+                guard let self, let listener, self.server === listener else { return }
+                listener.onStateChange = nil
+                listener.stop()
+                self.server = nil
+                self.captureProbe.setListenerActive(false)
+                Self.logBuffer.append("NG8 capture-only listener failed/cancelled; coordinator parked")
+            }
