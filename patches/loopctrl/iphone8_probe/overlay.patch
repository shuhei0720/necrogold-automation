+            guard origin == .trustedInProcess else {
+                completion(nil, captureOnlyError("trusted_local_required")); return
+            }
+            DispatchQueue.main.async { [weak self] in
+                guard let self else { completion(nil, .internalError); return }
+                if let id = params["revoke_session_id"]?.stringValue {
+                    let existed = AuthManager.shared.activeSessions.contains { $0.id == id }
+                    AuthManager.shared.revokeSession(id: id)
+                    if existed { self.captureProbe.ownerChanged() }
+                } else if params["clear_sessions"]?.boolValue == true {
