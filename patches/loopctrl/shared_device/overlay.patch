+// NG2 DEVICE GEOMETRY BINDING BEGIN
+// A local immutable snapshot owned by one NG2Run, orthogonal to run.profile.
+// It cannot be selected by RPC parameters or changed by a later command.
+struct NG2DeviceGeometryBinding {
+    let profile: UnsafePointer<NG2DeviceGeometryProfile>?
+    let panelWidth: Int32
+    let panelHeight: Int32
+    let model: String?
+    var legacyPassthrough: Bool { profile?.pointee.legacy_passthrough == 1 }
+
+    static func local() -> NG2DeviceGeometryBinding {
+        #if NG2_RUNTIME_HOST_TEST
+        if let fixture = NG2RuntimeTestHooks.deviceGeometry { return fixture() }
+        return NG2DeviceGeometryBinding(profile: ng2_device_geometry_profile(nil, 414, 896),
+            panelWidth: 414, panelHeight: 896, model: nil)
+        #else
+        var bytes = [CChar](repeating: 0, count: 128)
+        let model: String? = bytes.withUnsafeMutableBufferPointer { buffer in
+            guard ng2_device_local_model(buffer.baseAddress!, buffer.count) == 1 else { return nil }
+            return String(cString: buffer.baseAddress!)
+        }
+        // bounds is compatibility-mode320x480 in some runners. Native physical
+        // pixels/nativeScale are local panel data, not screenshot EXIF/input
+        // transforms or an AX foreground query inside the input gate.
+        let screen = UIScreen.main
+        let scale = screen.nativeScale
+        let native = screen.nativeBounds.size
+        let width = min(native.width, native.height) / scale
+        let height = max(native.width, native.height) / scale
+        guard scale.isFinite, scale > 0, width.isFinite, height.isFinite,
+              width > 0, height > 0, width <= 4096, height <= 4096,
+              width.rounded() == width, height.rounded() == height else {
+            return NG2DeviceGeometryBinding(profile: nil, panelWidth: 0, panelHeight: 0, model: model)
+        }
+        let w = Int32(width), h = Int32(height)
+        let selected: UnsafePointer<NG2DeviceGeometryProfile>?
+        if let model { selected = model.withCString { ng2_device_geometry_profile($0, w, h) } }
+        else { selected = ng2_device_geometry_profile(nil, w, h) }
+        return NG2DeviceGeometryBinding(profile: selected, panelWidth: w, panelHeight: h, model: model)
+        #endif
+    }
+
+    func resolvedPoint(_ command: NG2Command) -> CGPoint? {
+        guard let profile else { return nil }
+        var point = NG2DeviceInputPoint()
+        guard ng2_device_dispatch_point(profile, command.kind, command.direction,
+            command.x, command.y, &point) == 1 else { return nil }
+        return CGPoint(x: point.x, y: point.y)
+    }
+}
